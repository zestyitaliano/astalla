{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "paths": {
      "@shared/*": [
        "../../packages/shared/dist/*"
      ],
      "@prisma/client": [
        "src/prisma/shims/prisma-client-shim.ts"
      ]
    },
    "noImplicitAny": false
  }
}
