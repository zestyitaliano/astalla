{
  "name": "apps-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "sh -c 'node dist/main.js || node dist/apps/backend/main.js || node dist/src/main.js'",
    "prebuild": "pnpm -C ../../packages/shared build",
    "build": "nest build",
    "postbuild": "echo '--- dist ---' && ls -la dist || true && echo '--- dist/apps/backend ---' && ls -la dist/apps/backend || true && echo '--- apps/backend/dist ---' && ls -la apps/backend/dist || true",
    "lint": "eslint ./src --ext .ts",
    "typecheck": "tsc --noEmit",
    "smoke:auth": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/smoke-auth.ts",
    "smoke:tables": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/smoke-tables.ts",
    "test:smoke:api": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/smoke-api.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.7",
    "@nestjs/websockets": "^10.4.7",
    "@shared/api": "workspace:*",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vm2": "^3.9.19",
    "yjs": "^13.6.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
