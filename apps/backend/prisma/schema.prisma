generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORG_ADMIN
  REGIONAL
  PROPERTY
  MARKETING
}

enum SourceAccountType {
  ENTRATA
  GOOGLE_ADS
  GA4
  GBP
  WORDPRESS
}

enum ApplicationStatus {
  STARTED
  SUBMITTED
  APPROVED
  DENIED
  CANCELLED
}

enum LeaseStatus {
  PENDING
  ACTIVE
  NOTICE
  TERMINATED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewProvider {
  GBP
}

model Org {
  id             String           @id @default(cuid())
  name           String
  properties     Property[]
  roles          UserOrgRole[]
  sops           SOP[]
  billingItems   BillingItem[]
  reports        ReportSnapshot[]
  thresholds     KPIThreshold[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  roles     UserOrgRole[]
}

model UserOrgRole {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  org        Org       @relation(fields: [orgId], references: [id])
  orgId      String
  role       UserRole
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, orgId, role, propertyId])
}

model Property {
  id                   String                @id @default(cuid())
  org                  Org                   @relation(fields: [orgId], references: [id])
  orgId                String
  propertyCode         String                @unique
  name                 String
  region               String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  unitCount            Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  units                Unit[]
  leads                Lead[]
  leadEvents           LeadEvent[]
  applications         Application[]
  leases               Lease[]
  availabilitySnapshots AvailabilitySnapshot[]
  channelSpend         ChannelSpend[]
  conversionEvents     ConversionEvent[]
  reviews              Review[]
  sentimentSummaries   SentimentSummary[]
  thresholds           KPIThreshold[]
  reportSnapshots      ReportSnapshot[]
  alerts               Alert[]
  sourceAccounts       SourceAccount[]
  tickets              Ticket[]
  tasks                Task[]
  billingItems         BillingItem[]
  scrapeJobs           ScrapeJob[]
}

model SourceAccount {
  id          String            @id @default(cuid())
  property    Property          @relation(fields: [propertyId], references: [id])
  propertyId  String
  type        SourceAccountType
  credential  Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([propertyId, type], name: "idx_source_account_property_type")
}

model Lead {
  id           String        @id @default(cuid())
  property     Property      @relation(fields: [propertyId], references: [id])
  propertyId   String
  externalId   String
  source       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  gclid        String?
  gbraid       String?
  wbraid       String?
  application  Application?
  lease        Lease?
  events       LeadEvent[]
  conversions  ConversionEvent[]

  @@unique([propertyId, externalId], name: "uniq_lead_property_external")
  @@index([propertyId, createdAt], name: "idx_lead_property_created")
}

model LeadEvent {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String
  property    Property  @relation(fields: [propertyId], references: [id])
  propertyId  String
  type        String
  occurredAt  DateTime
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([propertyId, occurredAt], name: "idx_lead_event_property_time")
}

model Application {
  id          String            @id @default(cuid())
  lead        Lead              @relation(fields: [leadId], references: [id])
  leadId      String            @unique
  property    Property          @relation(fields: [propertyId], references: [id])
  propertyId  String
  status      ApplicationStatus
  submittedAt DateTime
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leases      Lease[]

  @@index([propertyId, submittedAt], name: "idx_application_property_submitted")
}

model Lease {
  id          String      @id @default(cuid())
  lead        Lead        @relation(fields: [leadId], references: [id])
  leadId      String      @unique
  property    Property    @relation(fields: [propertyId], references: [id])
  propertyId  String
  unit        Unit?       @relation(fields: [unitId], references: [id])
  unitId      String?
  startDate   DateTime
  endDate     DateTime?
  status      LeaseStatus
  moveOutAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([propertyId, startDate], name: "idx_lease_property_start")
  @@index([propertyId, endDate], name: "idx_lease_property_end")
}

model Unit {
  id         String     @id @default(cuid())
  property   Property   @relation(fields: [propertyId], references: [id])
  propertyId String
  unitCode   String
  bedrooms   Int?
  bathrooms  Float?
  rentable   Boolean    @default(true)
  rent       Decimal?   @db.Decimal(12, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  leases     Lease[]

  @@unique([propertyId, unitCode], name: "uniq_unit_property_code")
}

model AvailabilitySnapshot {
  id             String    @id @default(cuid())
  property       Property  @relation(fields: [propertyId], references: [id])
  propertyId     String
  at             DateTime
  availableUnits Int
  occupiedUnits  Int?
  totalUnits     Int?
  createdAt      DateTime  @default(now())

  @@index([propertyId, at], name: "idx_availability_property_at")
}

model ChannelSpend {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  day        DateTime
  channel    String
  campaignId String?
  cost       Decimal   @db.Decimal(14, 4)
  currency   String?   @default("USD")
  createdAt  DateTime  @default(now())

  @@index([propertyId, day], name: "idx_channel_spend_property_day")
}

model ConversionEvent {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  lead       Lead?     @relation(fields: [leadId], references: [id])
  leadId     String?
  day        DateTime
  type       String
  count      Int       @default(0)
  gclid      String?
  gbraid     String?
  wbraid     String?
  createdAt  DateTime  @default(now())

  @@index([propertyId, day], name: "idx_conversion_event_property_day")
}

model Review {
  id              String          @id @default(cuid())
  property        Property        @relation(fields: [propertyId], references: [id])
  propertyId      String
  provider        ReviewProvider  @default(GBP)
  authorName      String?
  rating          Int
  text            String
  at              DateTime
  reviewerEmail   String?
  reviewerPhoto   String?
  responseText    String?
  respondedAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime        @default(now())

  @@index([propertyId, at], name: "idx_review_property_at")
}

model SentimentSummary {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  weekStart  DateTime
  posPct     Float
  negPct     Float
  topics     Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([propertyId, weekStart], name: "uniq_sentiment_property_week")
}

model KPIThreshold {
  id         String    @id @default(cuid())
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  org        Org?      @relation(fields: [orgId], references: [id])
  orgId      String?
  kpi        String
  target     Float
  warnBelow  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([propertyId, kpi])
}

model ReportSnapshot {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id])
  propertyId  String
  weekStart   DateTime
  occupancy   Float
  cpl         Float?
  cpls        Float?
  red         Boolean   @default(false)
  watch       Boolean   @default(false)
  payload     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, weekStart], name: "uniq_report_property_week")
}

model Alert {
  id          String        @id @default(cuid())
  property    Property      @relation(fields: [propertyId], references: [id])
  propertyId  String
  type        String
  message     String
  at          DateTime
  severity    AlertSeverity @default(MEDIUM)
  acknowledgedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([propertyId, at], name: "idx_alert_property_at")
}

model Ticket {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id])
  propertyId  String
  title       String
  status      String    @default("OPEN")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
}

model Task {
  id          String     @id @default(cuid())
  ticket      Ticket?    @relation(fields: [ticketId], references: [id])
  ticketId    String?
  property    Property?  @relation(fields: [propertyId], references: [id])
  propertyId  String?
  title       String
  status      String     @default("PENDING")
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  dueAt       DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SOP {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  body      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingItem {
  id         String    @id @default(cuid())
  org        Org?      @relation(fields: [orgId], references: [id])
  orgId      String?
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  description String
  amount     Decimal   @db.Decimal(12, 2)
  status     String    @default("OPEN")
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ScrapeJob {
  id          String     @id @default(cuid())
  property    Property?  @relation(fields: [propertyId], references: [id])
  propertyId  String?
  type        String
  status      String    @default("PENDING")
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  findings    Finding[]
}

model Finding {
  id         String        @id @default(cuid())
  job        ScrapeJob?    @relation(fields: [jobId], references: [id])
  jobId      String?
  property   Property?     @relation(fields: [propertyId], references: [id])
  propertyId String?
  message    String
  severity   AlertSeverity @default(MEDIUM)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
}

model EtlCursor {
  id        String            @id @default(cuid())
  source    SourceAccountType
  scope     String
  cursor    Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([source, scope], name: "uniq_etl_source_scope")
}
