generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  REGIONAL
  PROPERTY
  MARKETING
}

enum SourceAccountType {
  ENTRATA
  GOOGLE_ADS
  GA4
  GBP
}

enum LeadEventType {
  INBOUND
  OUTBOUND
  TOUR_SCHEDULED
  TOUR_COMPLETED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  LEASE_SIGNED
}

enum ApplicationStatus {
  STARTED
  SUBMITTED
  APPROVED
  DENIED
  CANCELLED
}

enum LeaseStatus {
  PENDING
  ACTIVE
  NOTICE_GIVEN
  TERMINATED
  EXPIRED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Org {
  id          String           @id @default(cuid())
  name        String
  properties  Property[]
  users       UserOrgRole[]
  reports     ReportSnapshot[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  roles     UserOrgRole[]
}

model UserOrgRole {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  role       Role
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId, role])
}

model Property {
  id            String            @id @default(cuid())
  org           Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String
  propertyCode  String            @unique
  name          String
  region        String?
  unitCount     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  leads         Lead[]
  leases        Lease[]
  units         Unit[]
  availability  AvailabilitySnapshot[]
  channelSpend  ChannelSpend[]
  conversions   ConversionEvent[]
  reviews       Review[]
  sentiments    SentimentSummary[]
  thresholds    KPIThreshold[]
  members       UserOrgRole[]
  snapshots     ReportSnapshot[]
  alerts        Alert[]
  sources       SourceAccount[]
}

model SourceAccount {
  id         String             @id @default(cuid())
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  type       SourceAccountType
  credential Json
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([propertyId, type])
}

model Lead {
  id          String      @id @default(cuid())
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  externalId  String
  source      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      LeadEvent[]
  application Application?
  lease       Lease?

  @@unique([propertyId, externalId])
}

model LeadEvent {
  id       String        @id @default(cuid())
  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   String
  type     LeadEventType
  at       DateTime      @default(now())
  meta     Json?

  @@index([leadId, at])
}

model Application {
  id          String            @id @default(cuid())
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String            @unique
  status      ApplicationStatus
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Lease {
  id         String      @id @default(cuid())
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String      @unique
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  startDate  DateTime
  endDate    DateTime
  status     LeaseStatus
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Unit {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  unitCode   String
  bedrooms   Int
  bathrooms  Float
  rentable   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([propertyId, unitCode])
}

model AvailabilitySnapshot {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  at          DateTime
  availableUnits Int

  @@index([propertyId, at])
}

model ChannelSpend {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  day        DateTime
  channel    String
  campaignId String
  cost       Float

  @@index([propertyId, day])
}

model ConversionEvent {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  day        DateTime
  type       String
  count      Int
  gclid      String?
  gbraid     String?
  wbraid     String?

  @@index([propertyId, day])
}

model Review {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  provider   String
  rating     Int
  text       String
  at         DateTime

  @@index([propertyId, at])
}

model SentimentSummary {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  weekStart  DateTime
  posPct     Float
  negPct     Float
  topics     Json

  @@unique([propertyId, weekStart])
}

model KPIThreshold {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  kpi        String
  target     Float
  warnBelow  Float

  @@unique([propertyId, kpi])
}

model ReportSnapshot {
  id          String    @id @default(cuid())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  weekStart   DateTime
  occupancy   Float
  cpl         Float
  cpls        Float
  red         Boolean
  watch       Boolean
  json        Json
  createdAt   DateTime   @default(now())

  @@unique([propertyId, weekStart])
}

model Alert {
  id         String       @id @default(cuid())
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  type       String
  message    String
  severity   AlertSeverity
  at         DateTime      @default(now())
}
