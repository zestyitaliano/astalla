{
  "name": "astalla",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format --if-present",
    "smoke": "node scripts/smoke.mjs",
    "prebuild:backend": "pnpm -C packages/shared build"
  }
}
