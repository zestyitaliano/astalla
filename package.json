{
  "name": "astalla",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format --if-present",
    "smoke": "node scripts/smoke.mjs",
    "prebuild:backend": "pnpm -C packages/shared build"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
